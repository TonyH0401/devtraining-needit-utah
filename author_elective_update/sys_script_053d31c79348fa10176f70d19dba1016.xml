        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {
    var inc = current.incident.getRefRecord();
    if (inc) {
        var msg = 'Incident Task ' + current.number +
            ' has been completed with close note: "' + current.close_notes +
            '" by ' + current.assigned_to.getDisplayValue();
        inc.work_notes = msg;
        // inc.state = 7; // Optionally close the Incident too
        inc.update();
    }
})(current, previous);]]></script>
