        <script><![CDATA[(function executeRule(current, previous) {
	// Make sure the operation is update only, insert won't trigger it
    if (!current.isValidRecord() || current.operation() != 'update')
        return;

	// Inc Task is WIP and commetns fields change
    if (current.state == 2 && current.comments.changes()) {
        var inc = current.incident.getRefRecord();
		// Inc is WIP
        if (inc && inc.state == 2) {
			// only the actual comment text
            var lastCommentText = current.comments.getJournalEntry(1, true);

            if (lastCommentText) {
                // Append to Incident comments
                var msg = "Update from Incident Task " + current.number + ": " + lastCommentText;
                inc.comments = msg;
                inc.update();

                // Update u_last_synced_comment safely using GlideRecord, get the lastest, prevent dup
                var gr = new GlideRecord('incident_task');
                if (gr.get(current.sys_id)) {
                    gr.u_last_synced_comment = lastCommentText;
                    gr.update(); // this is safe because it's a separate GR
                }
            }
        }
    }

})(current, previous);
]]></script>
